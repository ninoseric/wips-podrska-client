# Zajedničke vrijednosti za obje verzije klijenta (apply-patches.sh zamjenjuje @@WIPS_*@@ oznake).
# Naziv i način rada svake verzije su u wips/varijante/<varijanta>.env.
# Sve je javno: javni ključ servera nije tajna (privatni ključ ostaje samo na serveru).
WIPS_COMPANY=WiPS
WIPS_HOST=rd.wips.hr
# Javni ključ servera rd.wips.hr (data/id_ed25519.pub na wips-vps1, generiran 2. 11. 2026.).
WIPS_PUB_KEY=eE8tTb4nhQSVyLLBND8mk261DQhhdu1PfTgdv65Wuto=
# Linkovi u "O aplikaciji". Izvorni kod mora biti javno dostupan prije distribucije klijentima (AGPL);
# promijeniti kad repozitorij prijeđe u WiPS organizaciju.
WIPS_WEBSITE=https://www.wips.hr
WIPS_SOURCE_URL=https://github.com/ninoseric/wips-podrska-client
