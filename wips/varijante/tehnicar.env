# Tehničarska verzija, za WiPS tehničare: dvosmjerna (prazan conn-type). Samo interno, ne objavljuje se klijentima.
# Naziv mora biti različit od korisničke verzije: o njemu ovise mapa instalacije, Windows servis, postavke i ID.
WIPS_APP_NAME=WiPSPodrskaTehnicar
WIPS_DISPLAY_NAME=WiPS Podrska Tehnicar
WIPS_CONN_TYPE=
# Tehnicaru ostaju kartice Mreza, Racun i Pisac.
WIPS_SKRIJ_KARTICE=
# Tehnicaru ostaje zadani nacin odobravanja (lozinka ili klik); ovaj naziv opcije nitko ne cita.
WIPS_SAMO_KLIK_OPCIJA=wips-nekoristeno
