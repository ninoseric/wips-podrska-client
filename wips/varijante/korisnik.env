# Korisnička verzija, za klijente: samo prima veze (jezgra odbija odlazne, src/client.rs "Incoming only mode").
# Objavljuje se na stranici za preuzimanje.
WIPS_APP_NAME=WiPSPodrska
WIPS_DISPLAY_NAME=WiPS Udaljena Korisnicka Podrska
WIPS_CONN_TYPE=incoming
# Skriva kartice Mreza, Racun i Pisac u Postavkama (Y = skrij).
WIPS_SKRIJ_KARTICE=Y
