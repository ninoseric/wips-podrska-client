diff --git a/flutter/lib/desktop/pages/wips_incoming_home.dart b/flutter/lib/desktop/pages/wips_incoming_home.dart
new file mode 100644
index 0000000..ece5fd3
--- /dev/null
+++ b/flutter/lib/desktop/pages/wips_incoming_home.dart
@@ -0,0 +1,339 @@
+// WiPS: početni prozor korisničke verzije (samo prima veze), smjer C "Svijetli Fluent".
+// Mijenja se samo izgled; ID, lozinka, stanje veze, postavke i instalacija ostaju RustDeskovi.
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/desktop/pages/desktop_tab_page.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:flutter_hbb/models/server_model.dart';
+import 'package:flutter_hbb/models/state_model.dart';
+import 'package:flutter_hbb/utils/multi_window_manager.dart';
+import 'package:get/get.dart';
+import 'package:provider/provider.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+const _kFont = 'Manrope';
+const _kMono = 'Consolas';
+const _kWidth = 340.0;
+const _kPhone = '01/61 76 166';
+const _kWeb = 'https://wips.hr';
+
+class _Pal {
+  final Color bg, card, border, chip, text, muted, primary, onPrimary, ok;
+  const _Pal(this.bg, this.card, this.border, this.chip, this.text, this.muted,
+      this.primary, this.onPrimary, this.ok);
+
+  static const light = _Pal(
+      Color(0xFFFAFAFB),
+      Color(0xFFFFFFFF),
+      Color(0xFFE5E7EB),
+      Color(0xFFF3F4F6),
+      Color(0xFF111827),
+      Color(0xFF4B5563),
+      Color(0xFF1F2937),
+      Color(0xFFFFFFFF),
+      Color(0xFF15803D));
+  static const dark = _Pal(
+      Color(0xFF1B1C20),
+      Color(0xFF25272C),
+      Color(0xFF34363C),
+      Color(0xFF30333A),
+      Color(0xFFF3F4F6),
+      Color(0xFFB4B9C2),
+      Color(0xFFE5E7EB),
+      Color(0xFF111827),
+      Color(0xFF4ADE80));
+
+  static _Pal of(BuildContext context) =>
+      Theme.of(context).brightness == Brightness.dark ? dark : light;
+}
+
+TextStyle _ts(double size, FontWeight weight, Color color,
+        {double? spacing, String family = _kFont}) =>
+    TextStyle(
+        fontFamily: family,
+        fontSize: size,
+        fontWeight: weight,
+        color: color,
+        letterSpacing: spacing);
+
+/// [contentKey] mora biti na stupcu sa sadržajem: po njegovoj veličini se ravna prozor.
+/// [onlineStatus] mora ostati u stablu i kad se ne vidi, jer njegov timer osvježava stateGlobal.svcStatus.
+Widget buildWipsIncomingHome(BuildContext context,
+    {required Key contentKey,
+    required Widget presetPasswordWarning,
+    required Widget helpCards,
+    required Widget onlineStatus}) {
+  final p = _Pal.of(context);
+  final showInstall = isWindows &&
+      !bind.isDisableInstallation() &&
+      !bind.mainIsInstalled();
+  return ChangeNotifierProvider.value(
+    value: gFFI.serverModel,
+    child: Container(
+    width: _kWidth,
+    color: p.bg,
+    child: DefaultTextStyle.merge(
+      style: TextStyle(fontFamily: _kFont, color: p.text),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          SingleChildScrollView(
+            child: Column(
+              key: contentKey,
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              children: [
+                presetPasswordWarning,
+                _hero(context, p, onlineStatus),
+                Consumer<ServerModel>(
+                  builder: (context, model, child) =>
+                      _credentials(context, p, model),
+                ),
+                Padding(
+                  padding: const EdgeInsets.fromLTRB(22, 14, 22, 0),
+                  child: Text(
+                    translate('wips_support_tip'),
+                    textAlign: TextAlign.center,
+                    style: _ts(13, FontWeight.w500, p.muted),
+                  ),
+                ),
+                const SizedBox(height: 18),
+                if (showInstall) _installRow(p) else helpCards,
+                _footer(context, p),
+              ],
+            ),
+          ),
+          Expanded(child: Container()),
+        ],
+      ),
+    ),
+    ),
+  );
+}
+
+Widget _hero(BuildContext context, _Pal p, Widget onlineStatus) {
+  final dark = Theme.of(context).brightness == Brightness.dark;
+  return Padding(
+    padding: const EdgeInsets.fromLTRB(20, 18, 20, 0),
+    child: Column(
+      children: [
+        Image.asset(dark ? 'assets/logo_dark.png' : 'assets/logo.png',
+            width: 88,
+            height: 88,
+            errorBuilder: (ctx, error, stackTrace) =>
+                const SizedBox(width: 88, height: 88)),
+        const SizedBox(height: 10),
+        Obx(() {
+          final status = stateGlobal.svcStatus.value;
+          final ready = status == SvcStatus.ready;
+          return Column(
+            children: [
+              Text(
+                translate(ready
+                    ? 'Ready for support'
+                    : (status == SvcStatus.connecting
+                        ? 'Connecting to the server'
+                        : 'Support is not available')),
+                textAlign: TextAlign.center,
+                style: _ts(22, FontWeight.w800, p.text, spacing: -0.4),
+              ),
+              const SizedBox(height: 6),
+              Offstage(
+                offstage: !ready,
+                child: Row(
+                  mainAxisAlignment: MainAxisAlignment.center,
+                  children: [
+                    Container(
+                      width: 8,
+                      height: 8,
+                      decoration:
+                          BoxDecoration(color: p.ok, shape: BoxShape.circle),
+                    ),
+                    const SizedBox(width: 6),
+                    Text(translate('Connected to the WiPS server'),
+                        style: _ts(13, FontWeight.w600, p.ok)),
+                  ],
+                ),
+              ),
+              Offstage(offstage: ready, child: onlineStatus),
+            ],
+          );
+        }),
+      ],
+    ),
+  );
+}
+
+List<String> _idGroups(String id) {
+  final parts = id.trim().split(' ');
+  final digits = RegExp(r'^\d+$');
+  if (parts.length == 4 && parts.every((s) => digits.hasMatch(s))) {
+    return ['${parts[0]} ${parts[1]}', parts[2], parts[3]];
+  }
+  return [id];
+}
+
+Widget _label(String text, _Pal p) =>
+    Text(text, style: _ts(12.5, FontWeight.w600, p.muted));
+
+Widget _credentials(BuildContext context, _Pal p, ServerModel model) {
+  final showOneTime = model.approveMode != 'click' &&
+      model.verificationMethod != kUsePermanentPassword;
+  return Container(
+    margin: const EdgeInsets.fromLTRB(16, 20, 16, 0),
+    padding: const EdgeInsets.fromLTRB(18, 16, 18, 18),
+    decoration: BoxDecoration(
+      color: p.card,
+      border: Border.all(color: p.border),
+      borderRadius: BorderRadius.circular(12),
+    ),
+    child: Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        _label(translate('ID'), p),
+        const SizedBox(height: 8),
+        ValueListenableBuilder<TextEditingValue>(
+          valueListenable: model.serverId,
+          builder: (context, value, child) => Wrap(
+            spacing: 8,
+            runSpacing: 8,
+            children: _idGroups(value.text)
+                .map((g) => Container(
+                      padding: const EdgeInsets.symmetric(
+                          horizontal: 11, vertical: 5),
+                      decoration: BoxDecoration(
+                        color: p.chip,
+                        borderRadius: BorderRadius.circular(8),
+                      ),
+                      child: SelectableText(g,
+                          style: _ts(24, FontWeight.w700, p.text)),
+                    ))
+                .toList(),
+          ),
+        ),
+        if (showOneTime) ...[
+          const SizedBox(height: 16),
+          _label(translate('One-time Password'), p),
+          const SizedBox(height: 6),
+          Row(
+            children: [
+              Expanded(
+                child: ValueListenableBuilder<TextEditingValue>(
+                  valueListenable: model.serverPasswd,
+                  builder: (context, value, child) => SelectableText(
+                      value.text,
+                      style: _ts(24, FontWeight.w700, p.text,
+                          spacing: 3, family: _kMono)),
+                ),
+              ),
+              OutlinedButton.icon(
+                onPressed: () => bind.mainUpdateTemporaryPassword(),
+                icon: Icon(Icons.refresh, size: 16, color: p.muted),
+                label: Text(translate('Generate new'),
+                    style: _ts(13, FontWeight.w600, p.text)),
+                style: OutlinedButton.styleFrom(
+                  minimumSize: const Size(0, 36),
+                  padding: const EdgeInsets.symmetric(horizontal: 12),
+                  side: BorderSide(color: p.border),
+                  shape: RoundedRectangleBorder(
+                      borderRadius: BorderRadius.circular(8)),
+                ),
+              ),
+            ],
+          ),
+        ],
+        const SizedBox(height: 16),
+        SizedBox(
+          width: double.infinity,
+          height: 44,
+          child: ElevatedButton.icon(
+            onPressed: () {
+              final id = model.serverId.text.replaceAll(' ', '');
+              final text = showOneTime
+                  ? '${translate('ID')}: $id\n${translate('One-time Password')}: ${model.serverPasswd.text}'
+                  : '${translate('ID')}: $id';
+              Clipboard.setData(ClipboardData(text: text));
+              showToast(translate('Copied'));
+            },
+            icon: Icon(Icons.copy_rounded, size: 17, color: p.onPrimary),
+            label: Text(
+                translate(showOneTime ? 'Copy ID and password' : 'Copy ID'),
+                style: _ts(14, FontWeight.w700, p.onPrimary)),
+            style: ElevatedButton.styleFrom(
+              backgroundColor: p.primary,
+              foregroundColor: p.onPrimary,
+              elevation: 0,
+              shape: RoundedRectangleBorder(
+                  borderRadius: BorderRadius.circular(10)),
+            ),
+          ),
+        ),
+      ],
+    ),
+  );
+}
+
+Widget _installRow(_Pal p) {
+  return Container(
+    margin: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+    padding: const EdgeInsets.fromLTRB(14, 6, 6, 6),
+    decoration: BoxDecoration(
+      color: p.chip,
+      borderRadius: BorderRadius.circular(10),
+    ),
+    child: Row(
+      children: [
+        Icon(Icons.info_outline, size: 18, color: p.muted),
+        const SizedBox(width: 10),
+        Expanded(
+          child: Text(translate('wips_install_tip'),
+              style: _ts(12.5, FontWeight.w500, p.text)),
+        ),
+        TextButton(
+          onPressed: () async {
+            await rustDeskWinManager.closeAllSubWindows();
+            bind.mainGotoInstall();
+          },
+          child: Text(translate('Install'),
+              style: _ts(13, FontWeight.w700, p.text)),
+        ),
+      ],
+    ),
+  );
+}
+
+Widget _footer(BuildContext context, _Pal p) {
+  return Padding(
+    padding: const EdgeInsets.fromLTRB(20, 0, 8, 8),
+    child: Row(
+      children: [
+        Expanded(
+          child: Wrap(
+            crossAxisAlignment: WrapCrossAlignment.center,
+            children: [
+              Text('$_kPhone · ', style: _ts(12, FontWeight.w500, p.muted)),
+              InkWell(
+                onTap: () => launchUrl(Uri.parse(_kWeb)),
+                child: Text('wips.hr',
+                    style: _ts(12, FontWeight.w600, p.muted)
+                        .copyWith(decoration: TextDecoration.underline)),
+              ),
+              FutureBuilder<String>(
+                future: bind.mainGetVersion(),
+                builder: (context, snapshot) => Text(
+                    snapshot.hasData ? '  ·  v${snapshot.data}' : '',
+                    style: _ts(12, FontWeight.w500, p.muted)),
+              ),
+            ],
+          ),
+        ),
+        IconButton(
+          tooltip: translate('Settings'),
+          onPressed: () => DesktopTabPage.onAddSetting(),
+          icon: Icon(Icons.settings_outlined, size: 18, color: p.muted),
+        ),
+      ],
+    ),
+  );
+}
