@@ -0,0 +1,506 @@
+// WiPS: prozor za odobravanje i tijek veze u korisničkoj verziji (smjer C "Svijetli Fluent").
+// Dio je server_page.dart (part) da bi koristio istu logiku gumba (_CmControlPanel) bez kopiranja.
+part of 'server_page.dart';
+
+const _kWipsFont = 'Manrope';
+
+class _WipsCmPal {
+  final Color bg, card, border, chip, text, muted, primary, onPrimary, ok, warn, danger;
+  const _WipsCmPal(this.bg, this.card, this.border, this.chip, this.text, this.muted,
+      this.primary, this.onPrimary, this.ok, this.warn, this.danger);
+
+  static const light = _WipsCmPal(
+      Color(0xFFFAFAFB), Colors.white, Color(0xFFE5E7EB), Color(0xFFF3F4F6),
+      Color(0xFF111827), Color(0xFF4B5563), Color(0xFF1F2937), Colors.white,
+      Color(0xFF15803D), Color(0xFFB45309), Color(0xFFB42318));
+  static const dark = _WipsCmPal(
+      Color(0xFF1B1C20), Color(0xFF25272C), Color(0xFF34363C), Color(0xFF30333A),
+      Color(0xFFF3F4F6), Color(0xFFB4B9C2), Color(0xFFE5E7EB), Color(0xFF111827),
+      Color(0xFF4ADE80), Color(0xFFFBBF24), Color(0xFFF87171));
+
+  static _WipsCmPal of(BuildContext context) =>
+      Theme.of(context).brightness == Brightness.dark ? dark : light;
+}
+
+Widget _buildWipsConnectionCard(Client client) {
+  return Consumer<ServerModel>(
+    builder: (context, value, child) {
+      final pal = _WipsCmPal.of(context);
+      final showPermissions = !(client.type_() == ClientType.file ||
+          client.type_() == ClientType.portForward ||
+          client.type_() == ClientType.terminal ||
+          client.disconnected);
+      return Container(
+        color: pal.bg,
+        child: DefaultTextStyle.merge(
+          style: TextStyle(fontFamily: _kWipsFont, color: pal.text),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            key: ValueKey(client.id),
+            children: [
+              _WipsCmHeader(client: client),
+              if (!client.authorized && !client.disconnected)
+                _wipsApproveTip(pal),
+              showPermissions
+                  ? Expanded(child: _WipsPermissionList(client: client))
+                  : const Spacer(),
+              _WipsCmControlPanel(client: client),
+            ],
+          ).paddingSymmetric(vertical: 8.0, horizontal: 10.0),
+        ),
+      );
+    },
+  );
+}
+
+Widget _wipsApproveTip(_WipsCmPal pal) {
+  return Container(
+    margin: const EdgeInsets.only(top: 8),
+    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
+    decoration: BoxDecoration(
+      color: pal.chip,
+      borderRadius: BorderRadius.circular(8),
+    ),
+    child: Row(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Icon(Icons.shield_outlined, size: 16, color: pal.muted)
+            .marginOnly(right: 8, top: 1),
+        Expanded(
+          child: Text(
+            translate('wips_approve_tip'),
+            style: TextStyle(fontSize: 12, height: 1.35, color: pal.muted),
+          ),
+        ),
+      ],
+    ),
+  );
+}
+
+class _WipsCmHeader extends StatefulWidget {
+  final Client client;
+
+  const _WipsCmHeader({Key? key, required this.client}) : super(key: key);
+
+  @override
+  State<_WipsCmHeader> createState() => _WipsCmHeaderState();
+}
+
+class _WipsCmHeaderState extends State<_WipsCmHeader>
+    with AutomaticKeepAliveClientMixin {
+  Client get client => widget.client;
+
+  final _time = 0.obs;
+  Timer? _timer;
+
+  @override
+  void initState() {
+    super.initState();
+    _timer = Timer.periodic(Duration(seconds: 1), (_) {
+      if (client.authorized && !client.disconnected) {
+        _time.value = _time.value + 1;
+      }
+    });
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      gFFI.serverModel.tabController.onSelected?.call(client.id.toString());
+    });
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  @override
+  bool get wantKeepAlive => true;
+
+  String? _typeLabel() {
+    switch (client.type_()) {
+      case ClientType.terminal:
+        return translate("Terminal");
+      case ClientType.file:
+        return translate("Transfer file");
+      case ClientType.camera:
+        return translate("View camera");
+      default:
+        return client.portForward.isNotEmpty
+            ? "Port Forward: ${client.portForward}"
+            : null;
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    super.build(context);
+    final pal = _WipsCmPal.of(context);
+    final typeLabel = _typeLabel();
+    final showSidePageButton = client.authorized &&
+        (client.type_() == ClientType.remote ||
+            client.type_() == ClientType.file ||
+            client.type_() == ClientType.camera);
+    return Container(
+      padding: const EdgeInsets.all(12),
+      decoration: BoxDecoration(
+        color: pal.card,
+        border: Border.all(color: pal.border),
+        borderRadius: BorderRadius.circular(12),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            crossAxisAlignment: CrossAxisAlignment.center,
+            children: [
+              _buildAvatar(pal).marginOnly(right: 10),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(
+                      client.name,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyle(
+                          fontSize: 15,
+                          fontWeight: FontWeight.w700,
+                          color: pal.text),
+                    ),
+                    Text(
+                      "ID ${client.peerId}",
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyle(fontSize: 12, color: pal.muted),
+                    ),
+                    if (typeLabel != null)
+                      Text(
+                        typeLabel,
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: TextStyle(fontSize: 12, color: pal.muted),
+                      ),
+                  ],
+                ),
+              ),
+              if (showSidePageButton)
+                IconButton(
+                  tooltip: client.type_() == ClientType.file
+                      ? translate("Transfer file")
+                      : translate("Chat"),
+                  onPressed: () => checkClickTime(client.id, () {
+                    if (client.type_() == ClientType.file) {
+                      gFFI.chatModel.toggleCMFilePage();
+                    } else {
+                      gFFI.chatModel.toggleCMChatPage(
+                          MessageKey(client.peerId, client.id));
+                    }
+                  }),
+                  icon: Icon(
+                    client.type_() == ClientType.file
+                        ? Icons.folder_outlined
+                        : Icons.chat_bubble_outline_rounded,
+                    size: 20,
+                    color: pal.text,
+                  ),
+                  splashRadius: kDesktopIconButtonSplashRadius,
+                ),
+            ],
+          ),
+          const SizedBox(height: 10),
+          _buildStatus(pal),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildStatus(_WipsCmPal pal) {
+    final Color color;
+    final String text;
+    if (!client.authorized) {
+      color = pal.warn;
+      text = translate("Request access to your device");
+    } else if (client.disconnected) {
+      color = pal.muted;
+      text = translate("Disconnected");
+    } else {
+      color = pal.ok;
+      text = translate("Connected");
+    }
+    return Row(
+      children: [
+        Container(
+          width: 8,
+          height: 8,
+          decoration: BoxDecoration(color: color, shape: BoxShape.circle),
+        ).marginOnly(right: 8),
+        Flexible(
+          child: Text(
+            text,
+            maxLines: 1,
+            overflow: TextOverflow.ellipsis,
+            style: TextStyle(
+                fontSize: 12.5, fontWeight: FontWeight.w600, color: color),
+          ),
+        ),
+        if (client.authorized)
+          Obx(() => Text(
+                "  ·  ${formatDurationToTime(Duration(seconds: _time.value))}",
+                style: TextStyle(fontSize: 12.5, color: pal.muted),
+              )),
+      ],
+    );
+  }
+
+  Widget _buildAvatar(_WipsCmPal pal) {
+    final fallback = Container(
+      width: 44,
+      height: 44,
+      alignment: Alignment.center,
+      decoration: BoxDecoration(
+        color: pal.primary,
+        borderRadius: BorderRadius.circular(10),
+      ),
+      child: Text(
+        client.name.isNotEmpty ? client.name[0].toUpperCase() : '?',
+        style: TextStyle(
+            fontSize: 20, fontWeight: FontWeight.w700, color: pal.onPrimary),
+      ),
+    );
+    return buildAvatarWidget(
+          avatar: client.avatar,
+          size: 44,
+          borderRadius: 10,
+          fallback: fallback,
+        ) ??
+        fallback;
+  }
+}
+
+class _WipsPermission {
+  final bool enabled;
+  final IconData icon;
+  final String name;
+  final String label;
+  final void Function(bool) store;
+  const _WipsPermission(this.enabled, this.icon, this.name, this.label, this.store);
+}
+
+class _WipsPermissionList extends StatefulWidget {
+  final Client client;
+
+  const _WipsPermissionList({Key? key, required this.client}) : super(key: key);
+
+  @override
+  State<_WipsPermissionList> createState() => _WipsPermissionListState();
+}
+
+class _WipsPermissionListState extends State<_WipsPermissionList> {
+  Client get client => widget.client;
+
+  List<_WipsPermission> _items() {
+    final audio = _WipsPermission(client.audio, Icons.volume_up_outlined,
+        "audio", 'Enable audio', (v) => client.audio = v);
+    final recording = _WipsPermission(client.recording,
+        Icons.videocam_outlined, "recording", 'Enable recording session',
+        (v) => client.recording = v);
+    if (client.type_() == ClientType.camera) return [audio, recording];
+    return [
+      _WipsPermission(client.keyboard, Icons.keyboard_outlined, "keyboard",
+          'Enable keyboard/mouse', (v) => client.keyboard = v),
+      _WipsPermission(client.clipboard, Icons.content_paste_rounded,
+          "clipboard", 'Enable clipboard', (v) => client.clipboard = v),
+      audio,
+      _WipsPermission(client.file, Icons.upload_file_outlined, "file",
+          'Enable file copy and paste', (v) => client.file = v),
+      _WipsPermission(client.restart, Icons.restart_alt_rounded, "restart",
+          'Enable remote restart', (v) => client.restart = v),
+      recording,
+      if (isWindows)
+        _WipsPermission(client.blockInput, Icons.block, "block_input",
+            'Enable blocking user input', (v) => client.blockInput = v),
+      if (bind.mainSupportedPrivacyModeImpls() != '[]')
+        _WipsPermission(client.privacyMode, Icons.visibility_off_outlined,
+            "privacy_mode", 'Enable privacy mode', (v) => client.privacyMode = v),
+    ];
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final pal = _WipsCmPal.of(context);
+    final canModify =
+        bind.mainGetBuildinOption(key: kOptionEnablePermChangeInAcceptWindow) !=
+            'N';
+    final items = _items();
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text(
+          translate("Permissions").toUpperCase(),
+          style: TextStyle(
+              fontSize: 11,
+              fontWeight: FontWeight.w700,
+              letterSpacing: 0.6,
+              color: pal.muted),
+        ).marginOnly(top: 12, bottom: 6, left: 2),
+        Expanded(
+          child: Container(
+            decoration: BoxDecoration(
+              color: pal.card,
+              border: Border.all(color: pal.border),
+              borderRadius: BorderRadius.circular(12),
+            ),
+            child: ClipRRect(
+              borderRadius: BorderRadius.circular(12),
+              child: ListView.separated(
+                padding: EdgeInsets.zero,
+                itemCount: items.length,
+                separatorBuilder: (_, __) =>
+                    Divider(height: 1, thickness: 1, color: pal.border),
+                itemBuilder: (context, i) =>
+                    _buildRow(pal, items[i], canModify),
+              ),
+            ),
+          ),
+        ),
+      ],
+    );
+  }
+
+  Widget _buildRow(_WipsCmPal pal, _WipsPermission p, bool canModify) {
+    final label = translate(p.label);
+    return Tooltip(
+      message: label,
+      waitDuration: const Duration(milliseconds: 600),
+      child: InkWell(
+        onTap: canModify
+            ? () => checkClickTime(client.id, () {
+                  final enabled = !p.enabled;
+                  bind.cmSwitchPermission(
+                      connId: client.id, name: p.name, enabled: enabled);
+                  setState(() => p.store(enabled));
+                })
+            : null,
+        child: Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 7),
+          child: Row(
+            children: [
+              Icon(p.icon, size: 16, color: p.enabled ? pal.text : pal.muted)
+                  .marginOnly(right: 10),
+              Expanded(
+                child: Text(
+                  label,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  style: TextStyle(
+                      fontSize: 12.5,
+                      color: p.enabled ? pal.text : pal.muted),
+                ),
+              ),
+              _toggle(pal, p.enabled, canModify),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _toggle(_WipsCmPal pal, bool on, bool canModify) {
+    return Opacity(
+      opacity: canModify ? 1 : 0.6,
+      child: AnimatedContainer(
+        duration: const Duration(milliseconds: 150),
+        width: 30,
+        height: 17,
+        padding: const EdgeInsets.all(2),
+        alignment: on ? Alignment.centerRight : Alignment.centerLeft,
+        decoration: BoxDecoration(
+          color: on ? pal.ok : pal.border,
+          borderRadius: BorderRadius.circular(9),
+        ),
+        child: Container(
+          width: 13,
+          height: 13,
+          decoration: const BoxDecoration(
+              color: Colors.white, shape: BoxShape.circle),
+        ),
+      ),
+    );
+  }
+}
+
+/// Ista logika i redoslijed gumba kao _CmControlPanel; mijenja se samo izgled gumba.
+class _WipsCmControlPanel extends _CmControlPanel {
+  const _WipsCmControlPanel({Key? key, required Client client})
+      : super(key: key, client: client);
+
+  @override
+  Widget buildButton(BuildContext context,
+      {required Color? color,
+      GestureTapCallback? onClick,
+      Widget? icon,
+      BoxBorder? border,
+      required String text,
+      required Color? textColor,
+      String? tooltip,
+      GestureTapDownCallback? onTapDown}) {
+    assert(!(onClick == null && onTapDown == null));
+    final pal = _WipsCmPal.of(context);
+    final outlined = color == Colors.transparent;
+    final danger = color == Colors.red || color == Colors.redAccent;
+    final Color bg = outlined ? pal.card : (danger ? pal.danger : pal.primary);
+    final Color fg = outlined
+        ? pal.text
+        : (danger ? Colors.white : pal.onPrimary);
+    final borderRadius = BorderRadius.circular(8.0);
+    final btn = Material(
+      color: bg,
+      shape: RoundedRectangleBorder(
+        borderRadius: borderRadius,
+        side: outlined ? BorderSide(color: pal.border) : BorderSide.none,
+      ),
+      child: InkWell(
+        borderRadius: borderRadius,
+        onTap: () {
+          if (onClick == null) return;
+          checkClickTime(client.id, onClick);
+        },
+        onTapDown: (details) {
+          if (onTapDown == null) return;
+          checkClickTime(client.id, () {
+            onTapDown.call(details);
+          });
+        },
+        child: SizedBox(
+          height: 36,
+          child: Row(
+            mainAxisAlignment: MainAxisAlignment.center,
+            children: [
+              if (icon != null)
+                ColorFiltered(
+                  colorFilter: ColorFilter.mode(fg, BlendMode.srcIn),
+                  child: icon,
+                ).marginOnly(right: 6),
+              Flexible(
+                child: Text(
+                  translate(text),
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  textAlign: TextAlign.center,
+                  style: TextStyle(
+                      fontFamily: _kWipsFont,
+                      fontSize: 13,
+                      fontWeight: FontWeight.w600,
+                      color: fg),
+                ),
+              ),
+            ],
+          ).paddingSymmetric(horizontal: 8),
+        ),
+      ),
+    );
+    return (tooltip != null
+            ? Tooltip(message: translate(tooltip), child: btn)
+            : btn)
+        .marginSymmetric(horizontal: 3, vertical: 3);
+  }
+}
