+/// WiPS: opcija izbora servera ("" automatski, "glavni", "rezervni"); vidi wips/REZERVNI-SERVER.md.
+pub const WIPS_SERVER_OPCIJA: &str = "wips-server";
+
+pub fn wips_ima_rezervni() -> bool {
+    !"@@WIPS_HOST2@@".is_empty()
+}
+
+/// WiPS: na koji je server klijent sada prijavljen ("glavni", "rezervni" ili "" ako ni na jedan).
+pub fn wips_aktivni_server() -> String {
+    let online = ONLINE.lock().unwrap();
+    let radi = |host: &str| {
+        online
+            .iter()
+            .any(|(k, v)| *v > 0 && k.split(':').next() == Some(host))
+    };
+    if radi("@@WIPS_HOST@@") {
+        "glavni".to_owned()
+    } else if wips_ima_rezervni() && radi("@@WIPS_HOST2@@") {
+        "rezervni".to_owned()
+    } else {
+        String::new()
+    }
+}
